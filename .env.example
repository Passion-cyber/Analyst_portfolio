# ──────────────────────────────────────────────────────────────
#  Copy to `.env.local` for local dev. On Vercel, add these under
#  Project → Settings → Environment Variables.
#  Only variables prefixed with VITE_ are exposed to the browser.
# ──────────────────────────────────────────────────────────────

# Public URL of the deployed site (used for canonical tags, Open Graph,
# sitemap.xml and robots.txt). No trailing slash.
VITE_SITE_URL=https://tochukwu.vercel.app

# ── Content API (optional) ─────────────────────────────────────
# Leave empty to use the local files in src/content (default).
# When set, the site requests  {BASE}/projects, {BASE}/skills, …
# and silently falls back to the local files if a request fails.
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=6000

# ── Contact form ───────────────────────────────────────────────
# One of: web3forms | formspree | emailjs
VITE_FORM_PROVIDER=web3forms

# Web3Forms  → https://web3forms.com (free access key, no account needed)
VITE_WEB3FORMS_ACCESS_KEY=

# Formspree  → https://formspree.io  (the ID from https://formspree.io/f/<ID>)
VITE_FORMSPREE_FORM_ID=

# EmailJS    → https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
